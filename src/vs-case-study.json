    "text": "PROJECT 04  COMPUTER VISION AND GAME INTERACTION"
  },
  {
    "type": "heading",
    "level": "Title",
    "text": "Virtual Steering"
  },
  {
    "type": "paragraph",
    "level": "",
    "text": "A camera based controller that turns hand movement into steering input for a driving game."
  },
  {
    "type": "image",
    "file": "image1.png"
  },
  {
    "type": "paragraph",
    "level": "",
    "text": "MediaPipe hand landmarks running in the working prototype"
  },
  {
    "type": "grid",
    "rows": [
      [
        [
          {
            "type": "paragraph",
            "level": "",
            "text": "21hand landmarks"
          }
        ],
        [
          {
            "type": "paragraph",
            "level": "",
            "text": "4keyboard outputs"
          }
        ],
        [
          {
            "type": "paragraph",
