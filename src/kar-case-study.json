    "text": "PROJECT 03  CONVERSATIONAL AI AND VOICE INTERACTION"
  },
  {
    "type": "heading",
    "level": "Title",
    "text": "Sael"
  },
  {
    "type": "paragraph",
    "level": "",
    "text": "A voice first AI companion that listens, recognizes simple commands, adapts its tone to mood cues, and speaks its response."
  },
  {
    "type": "image",
